{
  "id": "com.official.workbench",
  "name": "Workbench UI",
  "description": "可点击的工作台界面：聊天（可上传文件/图片给 AI 看）/ 插件列表 / LLM 设置（含 API Key），支持鼠标点击与滚轮",
  "version": "1.0.0",
  "apiVersion": "1",
  "entry": "main",
  "runtime": "binary",
  "provides": ["ui.v1"],
  "consumes": ["conversation.v1", "session.v1", "agent.v1", "llm.v1", "toolExecutor.v1"],
  "permissions": ["filesystem:read", "shell:open"],
  "compat": {
    "core": ">=1.0 <2.0"
  }
}
