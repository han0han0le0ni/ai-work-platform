{
  "id": "com.official.workspace",
  "name": "Workspace Files",
  "description": "工作区文件插件：指定一个落脚文件夹，相对路径落在其中；绝对路径可访问整机（含各盘符），仅核心运行时目录受保护。自带界面：浏览目录、挑工作目录",
  "version": "1.1.0",
  "apiVersion": "1",
  "entry": "main",
  "runtime": "binary",
  "provides": ["workspace.v1", "ui.panel.v1"],
  "consumes": [],
  "permissions": ["filesystem:read", "filesystem:write", "filesystem:delete"],
  "compat": {
    "core": ">=1.0 <2.0"
  }
}
