{
  "id": "com.official.usage",
  "name": "Usage Monitor",
  "description": "用量悬浮窗：在终端右上角显示 DeepSeek 余额、token 消耗与缓存命中率。自带浮窗（ui.widget.usage.v1）：内容自己渲染，界面负责画 + 拖 + 收起",
  "version": "1.1.0",
  "apiVersion": "1",
  "entry": "main",
  "runtime": "binary",
  "provides": ["usage.v1", "ui.widget.usage.v1"],
  "consumes": ["llm.v1"],
  "permissions": ["network", "filesystem:read"],
  "compat": {
    "core": ">=1.0 <2.0"
  }
}
